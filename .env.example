# Ada — Environment Variables Example
#
# Copy this file to .env and fill in your values before running:
#   cp .env.example .env
#
# .env is gitignored and never committed. This file IS committed as
# documentation for required secrets.

# --- Required secrets ---

# JWT signing key — generate with: openssl rand -hex 32
ADA_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# LLM provider API key (choose one)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...   # Only needed if using openai_compat provider

# --- Optional overrides ---
# These have defaults in config/default.toml but can be overridden here.

# ADA_ENV=production
# ADA_LOGGING__FORMAT=json
# ADA_LLM__MODEL=claude-sonnet-4-5-20250514
